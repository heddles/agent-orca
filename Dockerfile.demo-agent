# syntax=docker/dockerfile:1
FROM python:3.12-alpine

RUN pip install --no-cache-dir openai

COPY <<'EOF' /app/agent.py
import os
import json
from http.server import BaseHTTPRequestHandler, HTTPServer
from openai import OpenAI

client = OpenAI(
    base_url=os.environ.get("OPENAI_BASE_URL", "http://localhost:8080/v1"),
    api_key=os.environ.get("OPENAI_API_KEY", "local"),
)

SYSTEM_PROMPT = os.environ.get("AGENTORC_SYSTEM_PROMPT", "You are a helpful assistant. Be concise and accurate.")

class Handler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass  # silence default access log

    def do_GET(self):
        if self.path == "/healthz":
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"ok")
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        if self.path != "/invoke":
            self.send_response(404)
            self.end_headers()
            return

        length = int(self.headers.get("Content-Length", 0))
        body = json.loads(self.rfile.read(length))
        user_input = body.get("input", "")
        run_id = body.get("run_id", "")

        print(f"run={run_id} input={user_input!r}", flush=True)

        response = client.chat.completions.create(
            model="default",
            messages=[
                {"role": "system", "content": SYSTEM_PROMPT},
                {"role": "user", "content": user_input},
            ],
        )
        output = response.choices[0].message.content or ""

        print(f"run={run_id} output={output!r}", flush=True)

        payload = json.dumps({"output": output}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)


if __name__ == "__main__":
    port = int(os.environ.get("PORT", "8000"))
    print(f"demo-agent listening on :{port}", flush=True)
    HTTPServer(("", port), Handler).serve_forever()
EOF

RUN chmod +x /app/agent.py

USER 65534

ENTRYPOINT ["python", "/app/agent.py"]
