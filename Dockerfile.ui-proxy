# Multi-stage build for the ui-proxy binary.
# Stage 1 builds the React SPA; Stage 2 compiles the Go proxy with the SPA embedded;
# Stage 3 produces a minimal distroless runtime image.
#
# Build (from repo root):
#   docker buildx build -f Dockerfile.ui-proxy -t agent-orc/ui-proxy:dev .

# ── Stage 1: React SPA ───────────────────────────────────────────────────────
FROM node:20-alpine AS ui-builder
WORKDIR /ui
COPY ui/package.json ui/package-lock.json* ./
RUN npm install
COPY ui/tsconfig.json ui/vite.config.ts ui/index.html ./
COPY ui/src/ ./src/
RUN npm run build

# ── Stage 2: Go proxy binary ─────────────────────────────────────────────────
FROM golang:1.25 AS go-builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY api/ api/
# Copy the built SPA into the Go package directory so //go:embed dist works.
COPY --from=ui-builder /ui/dist ./cmd/ui-proxy/dist/
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o bin/ui-proxy ./cmd/ui-proxy

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=go-builder /workspace/bin/ui-proxy .
USER 65534:65534
ENTRYPOINT ["/ui-proxy"]
