# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Built Go binaries at repo root (anchored to root; source in cmd/ is unaffected)
/main
/model-router
/mcp-ingester
/aoctl
bin/aoctl
/cmd/cmd

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# MAC
.DS_Store

# Kubeconfig might contain secrets
*.kubeconfig
# UI build artifacts
**/node_modules/
**/dist/

# Helm dependency charts (pulled by `helm dependency update`)
charts/demos/*/charts/

# Claude
CLAUDE.md
**/**/.claude/
**/**/Claude.md

# Serena MCP server
.serena/

# Helm Charts
charts/**/Chart.lock
charts/**/*.tgz
.poolside
.poolside/settings.local.yaml

# Python
*.pyc
*.pyo
*.pyd
__pycache__/

# zip files
*.zip
ui/test-results/.last-run.json

# Agent dirs
plans/*
graphify-out/
