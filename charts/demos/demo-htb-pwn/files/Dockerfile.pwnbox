# Pwnbox image for the demo-htb-pwn chart — KIND-DEV DEFAULT (slim).
#
# A curated pentest toolbelt on python:3.12-slim-bookworm. This slim variant covers
# recon, web vuln, exploitation (sans metasploit/rustscan — blackcart-only) and
# AD/forensics tooling via Debian packages, pinned release binaries and pip.
#
# For the FULL ~8GB blackcart toolbelt (adds metasploit-framework/msfvenom, rustscan,
# naabu, katana, dalfox, chisel, full wordlists, …) build instead:
#   docker build -t red-pwnbox:blackcart -f charts/demos/demo-htb-pwn/files/Dockerfile.pwnbox.blackcart .
# then point the chart at it (pwnbox.image.slim: false is the default).
#
# Built by the skaffold `demo-htb-pwn` profile (kind-load into the local cluster):
#   skaffold run -p demo-htb-pwn
FROM python:3.12-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive

# Enable contrib+non-free (pentest tools like nikto live there). The bookworm-slim
# base ships a deb822 sources file with `main` only; swap to a single traditional
# sources.list for contrib/non-free/non-free-firmware, tracked to the base's codename.
# dash is /bin/sh here, so `set -eu` (no pipefail).
RUN set -eu && . /etc/os-release && \
    rm -f /etc/apt/sources.list.d/debian.sources && \
    printf 'deb http://deb.debian.org/debian %s main contrib non-free non-free-firmware\n'            "$VERSION_CODENAME"    >  /etc/apt/sources.list && \
    printf 'deb http://deb.debian.org/debian %s-updates main contrib non-free non-free-firmware\n'      "$VERSION_CODENAME"   >> /etc/apt/sources.list && \
    printf 'deb http://security.debian.org/debian-security %s-security main contrib non-free non-free-firmware\n' "$VERSION_CODENAME" >> /etc/apt/sources.list

# ── System packages: openvpn (TUN) + Debian-shipped recon/web/exploit/AD base ──
# NOT in Debian's archives (sourced differently): enum4linux (→enum4linux-ng pip),
# commix (→pip), metasploit/rustscan (blackcart-only; "TOOL MISSING" on slim).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openvpn nmap masscan sqlmap nikto hydra \
      iproute2 net-tools dnsutils ca-certificates curl jq git unzip \
      whatweb dirb gobuster yara \
      john samba-common-bin \
      build-essential pkg-config libssl-dev libxml2-dev libpcap-dev \
      ruby perl python3-dev python3-venv \
      # Terminal multiplexer + raw-TCP tools for persistent/interactive sessions:
      #   tmux     - hold interactive (Sliver/ncat) sessions across MCP tool calls
      #   socat    - proxy/bridge raw TCP+SSL streams for C2 callbacks
      #   netcat-openbsd - the "nc" CLI (lightweight one-shot probes)
      #   ncat     - supports --ssl and stdin/stdout relay (tcp-connect MCP tool).
      #              NOTE: ncat is a SEPARATE Debian package — nmap does NOT bundle
      #              it (the old comment erroneously claimed it did). Without this
      #              the tcp-connect MCP tool hard-fails with "TOOL MISSING: ncat".
      tmux socat netcat-openbsd ncat \
 && rm -rf /var/lib/apt/lists/*

# ── ExploitDB + searchsploit ──────────────────────────────────────────────────
# offensive-security/exploitdb's GitHub `master` is now README-only (the live DB ships
# in the Kali/BlackArch `exploitdb` package — which the blackcart image has). On slim
# there is no packaged ExploitDB, so searchsploit-lookup / fetch-exploit(query=)
# report a clear "ExploitDB not present" message and suggest the blackcart image.
# fetch-exploit(url=) (allowlisted) still works on slim.
# (No-op placeholder kept as a named anchor for the blackcart variant / future DB.)

# ── Release binaries for the Go-based pentest toolbelt (pinned versions). ───────
# Release binaries are used instead of `go install` (avoids Go-module-path churn:
# gitleaks moved to zricethezav/gitleaks/v8; feroxbuster has no valid module path)
# and drops the ~100MB Go SDK. Each download is best-effort (`|| WARN`) so a stale
# asset name can't break the build — a missing tool reports "TOOL MISSING" at runtime.
# Bump versions in the ARGs (and the plan) when cutting a new image.
ARG NUCLEI_V=3.11.0 SUBFINDER_V=2.14.0 HTTPX_V=1.10.0 FFUF_V=2.2.1
ARG GITLEAKS_V=8.30.1 AMASS_V=5.1.1 TRIVY_V=v0.72.0
RUN set -u; \
    arch="$(dpkg --print-architecture)"; case "$arch" in aarch64|arm64) a=arm64; tarch=ARM64;; *) a=amd64; tarch=64bit;; esac; \
    { curl -fsSL "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_V}/nuclei_${NUCLEI_V}_linux_${a}.zip" -o /tmp/nuclei.zip \
      && unzip -o /tmp/nuclei.zip -d /tmp/nuclei >/dev/null && cp /tmp/nuclei/nuclei /usr/local/bin/nuclei \
      && chmod +x /usr/local/bin/nuclei && rm -rf /tmp/nuclei /tmp/nuclei.zip; } || echo "[pwnbox] WARN: nuclei binary skipped"; \
    { curl -fsSL "https://github.com/projectdiscovery/subfinder/releases/download/v${SUBFINDER_V}/subfinder_${SUBFINDER_V}_linux_${a}.zip" -o /tmp/subfinder.zip \
      && unzip -o /tmp/subfinder.zip -d /tmp/subfinder >/dev/null && cp /tmp/subfinder/subfinder /usr/local/bin/subfinder \
      && chmod +x /usr/local/bin/subfinder && rm -rf /tmp/subfinder /tmp/subfinder.zip; } || echo "[pwnbox] WARN: subfinder binary skipped"; \
    { curl -fsSL "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_V}/httpx_${HTTPX_V}_linux_${a}.zip" -o /tmp/httpx.zip \
      && unzip -o /tmp/httpx.zip -d /tmp/httpx >/dev/null && cp /tmp/httpx/httpx /usr/local/bin/httpx \
      && chmod +x /usr/local/bin/httpx && rm -rf /tmp/httpx /tmp/httpx.zip; } || echo "[pwnbox] WARN: httpx binary skipped"; \
    { curl -fsSL "https://github.com/ffuf/ffuf/releases/download/v${FFUF_V}/ffuf_${FFUF_V}_linux_${a}.tar.gz" -o /tmp/ffuf.tgz \
      && tar -xzf /tmp/ffuf.tgz -C /usr/local/bin ffuf && chmod +x /usr/local/bin/ffuf && rm -f /tmp/ffuf.tgz; } || echo "[pwnbox] WARN: ffuf binary skipped"; \
    { curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_V}/gitleaks_${GITLEAKS_V}_linux_${a}.tar.gz" -o /tmp/gitleaks.tgz \
      && tar -xzf /tmp/gitleaks.tgz -C /usr/local/bin gitleaks && chmod +x /usr/local/bin/gitleaks && rm -f /tmp/gitleaks.tgz; } || echo "[pwnbox] WARN: gitleaks binary skipped"; \
    { curl -fsSL "https://github.com/owasp-amass/amass/releases/download/v${AMASS_V}/amass_linux_${a}.tar.gz" -o /tmp/amass.tgz \
      && mkdir -p /tmp/amx && tar -xzf /tmp/amass.tgz -C /tmp/amx && cp "$(find /tmp/amx -name amass -type f | head -1)" /usr/local/bin/amass \
      && chmod +x /usr/local/bin/amass && rm -rf /tmp/amass.tgz /tmp/amx; } || echo "[pwnbox] WARN: amass binary skipped"; \
    { curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/${TRIVY_V}/trivy_${TRIVY_V#v}_Linux-${tarch}.tar.gz" -o /tmp/trivy.tgz \
      && tar -xzf /tmp/trivy.tgz -C /tmp trivy && mv /tmp/trivy /usr/local/bin/trivy && rm -f /tmp/trivy.tgz; } || echo "[pwnbox] WARN: trivy binary skipped"; \
    { curl -fsSL "https://github.com/epi052/feroxbuster/releases/latest/download/$(case "$a" in arm64) echo aarch64-linux-feroxbuster.zip;; *) echo x86_64-linux-feroxbuster.zip;; esac)" -o /tmp/fb.zip \
      && unzip -o /tmp/fb.zip -d /tmp/fb >/dev/null && mv /tmp/fb/feroxbuster /usr/local/bin/feroxbuster \
      && chmod +x /usr/local/bin/feroxbuster && rm -rf /tmp/fb /tmp/fb.zip; } || echo "[pwnbox] WARN: feroxbuster binary skipped"

# ── Python pentest libs ────────────────────────────────────────────────────────
# Required (reliable, small): impacket (deps rpcclient-style tooling + enum4linux-ng).
RUN pip install --no-cache-dir --break-system-packages impacket

# enum4linux-ng isn't on PyPI under that name anymore — install from its canonical
# git repo (setup.py present; deps are pure-python wheels). Best-effort: if it can't
# build, enum-shares reports "TOOL MISSING" (blackcart ships enum4linux-ng).
RUN pip install --no-cache-dir --break-system-packages "git+https://github.com/cddmp/enum4linux-ng.git" 2>/dev/null || \
    echo "[pwnbox] WARN: enum4linux-ng install failed — enum-shares will report TOOL MISSING"

# Best-effort: install each optional PyPI tool in its **own** pip call so one
# missing/misnamed package can't block the others. A failure -> the MCP server
# reports "TOOL MISSING" at runtime. These all ship in the blackcart image too.
# Note: netexec is NOT on PyPI and its git repo moved off public GitHub — it's
# blackcart-only (BlackArch `netexec`); netexec-scan reports TOOL MISSING on slim.
RUN set -u; for p in smbmap bloodhound-python volatility3 commix XSStrike checkov binwalk; do \
      pip install --no-cache-dir --break-system-packages "$p" >/dev/null 2>&1 \
      || echo "[pwnbox] WARN: $p install skipped"; done

# ── small wordlist for ffuf/feroxbuster/gobuster/dirb ──────────────────────────
RUN mkdir -p /usr/share/wordlists \
 && curl -sSL "https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/common.txt" \
      -o /usr/share/wordlists/common.txt

# ── Our MCP toolbelt server (mirrors charts/demos/demo-soc-triage MCP protocol) ─
WORKDIR /app
COPY pwnbox-mcp-server.py /app/pwnbox-mcp-server.py
COPY entrypoint.sh       /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh /app/pwnbox-mcp-server.py

# openvpn needs root to create tun0 + configure the interface.
USER root
ENTRYPOINT ["/app/entrypoint.sh"]
