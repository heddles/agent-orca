# Causal Discovery Microscope BFF Proxy
# Listens on port 8080
# OPERATOR_URL environment variable points to the operator (for general API access)
# MCP_SERVER_URL environment variable points to the causal-mcp-server (for causal analysis)

:8080 {
	# Proxy causal analysis API to the MCP server (JSON-RPC on /)
	handle /api/causal/* {
		reverse_proxy {env.MCP_SERVER_URL} {
			transport http {
				response_header_timeout 0
				read_timeout             0
				write_timeout            0
			}
		}
	}

	# Proxy other API requests to the operator
	handle /api/* {
		reverse_proxy {env.OPERATOR_URL} {
			transport http {
				response_header_timeout 0
				read_timeout             0
				write_timeout            0
			}
		}
	}

	# Serve static files with SPA fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}